# Copy to .env.local and fill in. Never commit .env.local.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Firebase client (public; from Firebase console > Project settings > Your apps) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# App Check (reCAPTCHA Enterprise site key). Leave blank to disable locally.
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=

# --- Firebase Admin (SERVER ONLY; from a service account JSON) ---
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Keep the quotes; \n sequences are converted to newlines at runtime.
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Random string used to hash client identifiers for enquiry rate limiting (server only).
RATE_LIMIT_SALT=

# Local testing only: point the Admin SDK at the Firestore emulator (no credentials needed).
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# --- SMTP (SERVER ONLY) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="RS Technology Group <no-reply@example.com>"
# Where new enquiry notifications are sent
BUSINESS_NOTIFY_EMAIL=rstechgroup25@gmail.com
SEND_CUSTOMER_CONFIRMATION=true

# --- Analytics (optional) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
