rules_version = '2';

// Access model
// - Quote requests are created ONLY by the server (Admin SDK bypasses rules).
//   The public can never read or write them directly.
// - Admins are users with the custom claim { admin: true }, granted by
//   scripts/grant-admin.ts. Hiding admin UI is NOT the access control; these rules are.
// - Published portfolio projects, published articles and site settings are publicly readable.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /quoteRequests/{id} {
      allow read, update: if isAdmin();
      allow create, delete: if false; // server-only create; archive instead of delete
      match /notes/{noteId} {
        allow read, create: if isAdmin();
        allow update, delete: if false;
      }
    }

    match /portfolioProjects/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    match /resourceArticles/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    match /siteSettings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /adminUsers/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if false; // managed via Admin SDK script only
    }

    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow write: if false; // server-only
    }

    match /rateLimits/{id} {
      allow read, write: if false; // server-only
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
